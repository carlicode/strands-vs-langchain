# Copy this file to .env and fill in your own values.
# .env is already gitignored — never commit real keys.

# Required for langchain/*.py
OPENAI_API_KEY=your_openai_api_key_here

# Optional for strands/*.py — only needed if you don't already have
# `aws configure` / AWS SSO set up with a default profile.
# AWS_PROFILE=default
# AWS_REGION=us-east-1

# Optional for strands/weather_agent_ollama.py — only needed if your
# Ollama server isn't running on the default local host/port, or you
# want a model other than llama3.1.
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL_ID=llama3.1
